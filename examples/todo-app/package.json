{
  "name": "@quiesco/example-todo-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "@quiesco/agent": "workspace:*",
    "@quiesco/native": "workspace:*"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@quiesco/core": "workspace:*",
    "@quiesco/cucumber": "workspace:*",
    "@quiesco/expo-plugin": "workspace:*",
    "@quiesco/web": "workspace:*",
    "@types/react": "~19.3.0",
    "playwright": "1.65.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:e2e": "EXPO_PUBLIC_QUIESCO=1 expo start --dev-client --port 8082",
    "build:android": "expo prebuild --platform android --clean && cd android && ./gradlew assembleDebug",
    "mock-server": "node mock-server/server.mjs",
    "web": "expo start --web",
    "test:e2e:android": "QUIESCO_PLATFORM=android cucumber-js",
    "bench:android": "QUIESCO_PLATFORM=android node bench/run.mts",
    "build:web": "EXPO_PUBLIC_QUIESCO=1 expo export --platform web",
    "test:e2e:web": "QUIESCO_PLATFORM=web cucumber-js"
  },
  "private": true
}
