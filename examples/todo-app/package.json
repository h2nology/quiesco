{
  "name": "@quiesco/example-todo-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@quiesco/agent": "workspace:*",
    "@quiesco/native": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-shake": "^6.11.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@quiesco/core": "workspace:*",
    "@quiesco/cucumber": "workspace:*",
    "@quiesco/expo-plugin": "workspace:*",
    "@quiesco/jest": "workspace:*",
    "@quiesco/steps": "workspace:*",
    "@quiesco/vitest": "workspace:*",
    "@quiesco/web": "workspace:*",
    "@types/react": "~19.3.0",
    "jest": "30.5.2",
    "playwright": "1.65.0",
    "quiesco": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:e2e": "EXPO_PUBLIC_QUIESCO=1 expo start --dev-client --port 8082",
    "build:android": "EXPO_PUBLIC_QUIESCO=1 expo prebuild --platform android --clean && cd android && ./gradlew assembleDebug",
    "build:ios": "EXPO_PUBLIC_QUIESCO=1 expo prebuild --platform ios --clean && xcodebuild -workspace ios/QuiescoTodo.xcworkspace -scheme QuiescoTodo -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build build",
    "mock-server": "node mock-server/server.mjs",
    "web": "expo start --web",
    "test:e2e:android": "QUIESCO_PLATFORM=android cucumber-js",
    "test:e2e:ios": "QUIESCO_PLATFORM=ios cucumber-js",
    "bench:android": "QUIESCO_PLATFORM=android node bench/run.mts",
    "bench:suite": "node bench/suite.mts",
    "build:web": "EXPO_PUBLIC_QUIESCO=1 expo export --platform web",
    "test:e2e:web": "QUIESCO_PLATFORM=web cucumber-js",
    "test:vitest": "vitest run --config vitest.e2e.config.mts",
    "test:jest": "jest --config jest.e2e.config.cjs",
    "test:steps": "cucumber-js --config cucumber.steps.mjs"
  },
  "private": true
}
