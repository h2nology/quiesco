{
  "expo": {
    "name": "Quiesco Todo",
    "slug": "quiesco-todo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.quiesco.todo",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Quiesco example: shows that test runs pre-grant permissions (quiesco.config.mts permissions).",
        "CFBundleLocalizations": [
          "en",
          "ja"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.quiesco.todo",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@quiesco/expo-plugin",
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Quiesco example: biometric authentication driven by app.device.biometrics (Phase 6.7)."
        }
      ],
      "expo-notifications"
    ],
    "scheme": "quiescotodo"
  }
}
