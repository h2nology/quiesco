  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@quiesco/core": "workspace:*",
    "@quiesco/protocol": "workspace:*"
  },
  "peerDependencies": {
    "playwright": ">=1.50"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "playwright": "1.65.0",
    "ws": "8.22.1"
  }
