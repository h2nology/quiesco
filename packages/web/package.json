{
  "name": "@quiesco/web",
  "version": "0.1.0",
  "description": "Quiesco web DeviceProvider (Playwright library). Install only to test on the web.",
  "license": "MIT",
  "author": "h2nology",
  "keywords": [
    "quiesco",
    "e2e",
    "testing",
    "expo",
    "react-native",
    "playwright",
    "web"
  ],
  "homepage": "https://github.com/h2nology/quiesco/tree/main/packages/web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h2nology/quiesco.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/h2nology/quiesco/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
