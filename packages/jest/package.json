{
  "name": "@quiesco/jest",
  "version": "0.1.0",
  "description": "Quiesco for Jest: a preset whose test environment runs one session for the run and gives tests `quiesco.app`",
  "license": "MIT",
  "author": "h2nology",
  "keywords": [
    "quiesco",
    "e2e",
    "testing",
    "expo",
    "react-native",
    "jest"
  ],
  "homepage": "https://github.com/h2nology/quiesco/tree/main/packages/jest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h2nology/quiesco.git",
    "directory": "packages/jest"
  },
  "bugs": {
    "url": "https://github.com/h2nology/quiesco/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    },
    "./teardown": {
      "types": "./dist/teardown.d.ts",
      "import": "./dist/teardown.js"
    },
    "./jest-preset": "./jest-preset.cjs"
  },
  "files": [
    "dist",
    "src",
    "jest-preset.cjs"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@quiesco/core": "workspace:*",
    "jest-environment-node": "30.5.2"
  },
  "devDependencies": {
    "@jest/environment": "30.5.2",
    "@jest/types": "30.5.1"
  },
  "peerDependencies": {
    "jest": ">=30"
  }
}
