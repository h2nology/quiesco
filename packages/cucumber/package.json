{
  "name": "@quiesco/cucumber",
  "version": "0.1.0",
  "description": "cucumber-js World and hooks for Quiesco",
  "license": "MIT",
  "author": "h2nology",
  "keywords": [
    "quiesco",
    "e2e",
    "testing",
    "expo",
    "react-native",
    "cucumber",
    "bdd",
    "gherkin"
  ],
  "homepage": "https://github.com/h2nology/quiesco/tree/main/packages/cucumber#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h2nology/quiesco.git",
    "directory": "packages/cucumber"
  },
  "bugs": {
    "url": "https://github.com/h2nology/quiesco/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@quiesco/core": "workspace:*"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0"
  },
  "peerDependencies": {
    "@cucumber/cucumber": ">=12"
  }
}
