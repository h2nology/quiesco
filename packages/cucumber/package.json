{
  "name": "@quiesco/cucumber",
  "version": "0.0.0",
  "description": "cucumber-js World and hooks for Quiesco",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@quiesco/core": "workspace:*"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0"
  },
  "peerDependencies": {
    "@cucumber/cucumber": ">=12"
  }
}
