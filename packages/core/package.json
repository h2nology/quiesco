{
  "name": "@quiesco/core",
  "version": "0.1.0",
  "description": "Quiesco host side: WebSocket server, Driver, device providers (test-runner agnostic)",
  "license": "MIT",
  "author": "h2nology",
  "keywords": [
    "quiesco",
    "e2e",
    "testing",
    "expo",
    "react-native",
    "ios-simulator",
    "android-emulator",
    "driver"
  ],
  "homepage": "https://github.com/h2nology/quiesco/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h2nology/quiesco.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/h2nology/quiesco/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "ios-runner/Host",
    "ios-runner/Runner",
    "ios-runner/QuiescoSystemUI.xcodeproj"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@quiesco/protocol": "workspace:*",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
