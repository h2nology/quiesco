{
  "name": "@quiesco/ui",
  "version": "0.2.0",
  "description": "Quiesco test UI: run tests from the browser and watch them live (quiesco ui).",
  "license": "MIT",
  "author": "h2nology",
  "keywords": [
    "quiesco",
    "e2e",
    "testing",
    "expo",
    "react-native",
    "ui"
  ],
  "homepage": "https://github.com/h2nology/quiesco/tree/main/packages/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h2nology/quiesco.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/h2nology/quiesco/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@quiesco/core": "workspace:*",
    "@quiesco/protocol": "workspace:*",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
