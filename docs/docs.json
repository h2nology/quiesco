{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Quiesco",
  "description": "Gray-box end-to-end testing for Expo apps on iOS, Android and the web.",
  "colors": {
    "primary": "#002fa7",
    "light": "#6f86ff",
    "dark": "#002fa7"
  },
  "logo": {
    "light": "/logo/logo.svg",
    "dark": "/logo/logo-dark.svg"
  },
  "favicon": "/logo/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "npm",
        "href": "https://www.npmjs.com/package/quiesco"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/h2nology/quiesco"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/h2nology/quiesco"
    }
  },
  "redirects": [
    {
      "source": "/native",
      "destination": "/quickstart"
    },
    {
      "source": "/zh/native",
      "destination": "/zh/quickstart"
    },
    {
      "source": "/ja/native",
      "destination": "/ja/quickstart"
    }
  ],
