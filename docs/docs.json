                "group": "Test runners",
                "pages": [
                  "runners",
                  "vitest",
                  "jest",
                  "cucumber"
                ]
              }
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "sync",
              "platforms",
              "driver-pattern",
              "parallel",
              "ui",
              "troubleshooting"
            ]
          },
          {
